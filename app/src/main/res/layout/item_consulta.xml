<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="6dp"
    android:backgroundTint="@android:color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/laranja"
        android:padding="20dp">

        <!-- Conteúdo principal em LinearLayout vertical -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data: "
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/textHorario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horário: "
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/textLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local: "
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/textTipoAgen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de agendamento: "
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/textProf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profissional: "
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Ícone da lixeira no canto inferior direito -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="Excluir"
            android:padding="4dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/white" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
